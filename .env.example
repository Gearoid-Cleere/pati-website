# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test-mode keys and Price IDs (Dashboard → Developers / Products)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PARENT=price_...
STRIPE_PRICE_SCHOOL=price_...
STRIPE_PRICE_ORGANISATION=price_...
STRIPE_PRICE_SCHOOL_PARENT=price_...
STRIPE_PRICE_ORGANISATION_USER=price_...

# January 2027 participant prices. Leave unset until the Stripe prices exist.
# Checkout for those routes fails without taking payment when a value is missing.
STRIPE_PRICE_AI_PARENT=price_...
STRIPE_PRICE_AI_SCHOOL_PARENT=price_...
STRIPE_PRICE_AI_ORGANISATION_USER=price_...

# January-only school access at €199.95. Leave empty until the Stripe price exists.
# Checkout fails without taking payment when this value is missing.
STRIPE_PRICE_AI_SCHOOL=

# Server-only HMAC secret for organisation-user registration links. Never expose this client-side.
ORGANISATION_USER_LINK_SECRET=

# Resend. Missing RESEND_API_KEY causes paid-session webhook 5xx retries.
# Missing or invalid PATI_OPS_EMAIL is a configuration failure for paid recognised
# journeys: Stripe receives 5xx and retries. Purchaser mail may still send on the
# same attempt; ops mail is retried independently.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PATI <beth.t@example.com>
PATI_OPS_EMAIL=schools@parentingandtechnologyinstitute.com

# Optional. When set, registration, invoice, and teacher-access emails are sent
# only to this address. Leave empty in production.
REGISTRATION_EMAIL_OVERRIDE_TO=
