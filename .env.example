# Public site URL used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test-mode keys and Price IDs (Dashboard → Developers / Products)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PARENT=price_...
STRIPE_PRICE_SCHOOL=price_...
STRIPE_PRICE_ORGANISATION=price_...
STRIPE_PRICE_SCHOOL_PARENT=price_...
STRIPE_PRICE_ORGANISATION_USER=price_...

# Server-only HMAC secret for organisation-user registration links. Never expose this client-side.
ORGANISATION_USER_LINK_SECRET=

# Resend. Missing RESEND_API_KEY causes paid-session webhook 5xx retries.
# Missing PATI_OPS_EMAIL skips ops mail only; purchaser mail still sends.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=PATI <beth.t@example.com>
PATI_OPS_EMAIL=schools@parentingandtechnologyinstitute.com
